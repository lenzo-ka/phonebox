# Include package data
include README.md
include CHANGELOG.md
include QUICKSTART.md
include config.example.yaml
recursive-include docs *.md *.json
recursive-include docs/patches *
recursive-include docs/locks *.txt
include LICENSE
include LICENSE-UNICODE
include LICENSE-DEEPPHONEMIZER
include THIRD_PARTY_NOTICES.md
include requirements.txt
include requirements-dev.txt

# Include all configuration files
recursive-include phonebox/config *.json *.xlit

# Include examples
recursive-include examples *.py *.sh

# Include tests
recursive-include tests *.py

# Exclude build artifacts
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
