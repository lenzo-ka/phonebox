# it_IT: Italian orthography.
#
# Open è/ò map to distinct grapheme letters (IPA symbols as orthography), while
# é/ó map to e/o. Accented a/i/u fold to their base letters because this model
# predicts segments, not lexical stress. Plain e/o remain ambiguous.
# Apostrophe dropped; hyphen kept.
#
# Both lexicon and OOV inputs are NFC by construction.

:: NFC ;

\u00E0 > a ;
\u00C0 > a ;
\u00E1 > a ;
\u00C1 > a ;
\u00EC > i ;
\u00CC > i ;
\u00ED > i ;
\u00CD > i ;
\u00F9 > u ;
\u00D9 > u ;
\u00FA > u ;
\u00DA > u ;
\u00E8 > \u025B ;
\u00C8 > \u025B ;
\u00E9 > e ;
\u00C9 > e ;
\u00F2 > \u0254 ;
\u00D2 > \u0254 ;
\u00F3 > o ;
\u00D3 > o ;

:: Any-Lower ;
:: Null ;
:: [^-.[:L:]] Remove ;
